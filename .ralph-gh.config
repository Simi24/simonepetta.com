# .ralph-gh.config: simonepetta.com
# See AGENTS.md for the standards the gate reviews against, SPEC.md for the design.

# The repo pins its Node version in .nvmrc; the machine's nvm default is older and
# shared with other projects, so each npm command prepends that version's bin dir
# for that command only. Install it once with `nvm install`.
NODE24_BIN="$HOME/.nvm/versions/node/v$(cat "$(dirname "${BASH_SOURCE[0]}")/.nvmrc")/bin"
RALPH_VERIFY_COMMANDS=(
  "PATH=\"$NODE24_BIN:\$PATH\" npm ci"
  "PATH=\"$NODE24_BIN:\$PATH\" npm test"
  "PATH=\"$NODE24_BIN:\$PATH\" npm run check"
  "PATH=\"$NODE24_BIN:\$PATH\" npm run build"
  "PATH=\"$NODE24_BIN:\$PATH\" npm run test:browser"
)

# No services to start: tests never touch the network.
RALPH_PREFLIGHT_CMD=""

# Yolo mode is not used: this repo deploys to production and holds infra.
RALPH_YOLO_ALLOWLIST=''

RALPH_DOC_FILES=("SPEC.md" "AGENTS.md" "README.md")

RALPH_BRANCH_PREFIX="ralph"
RALPH_DEFAULT_BASE_BRANCH="main"
RALPH_GATE_FIX_ROUNDS=2
RALPH_SESSION_TIMEOUT=7200

# The subscription is shared with other projects: on a usage-limit hit,
# requeue and exit cleanly.
RALPH_WAIT_FOR_RESET=0
RALPH_USAGE_WAIT_SECONDS=1800

export ANTHROPIC_MODEL=claude-sonnet-5
