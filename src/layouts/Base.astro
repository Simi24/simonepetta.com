---
import { SITE_INDEXABLE } from 'astro:env/server';
import SiteHeader from '../components/SiteHeader.astro';
import { CLOUDFLARE_BEACON_SCRIPT_SRC } from '../config/budget.ts';
import { site } from '../config/site.ts';
import type { LearningResourceJsonLd } from '../lib/corso-json-ld.ts';
import { serializeJsonLd } from '../lib/json-ld-script.ts';
import type { PersonJsonLd } from '../lib/person-json-ld.ts';
import themeScript from '../scripts/theme.js?raw';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Hreflang {
  lang: string;
  href: string;
}

interface OpenGraph {
  image: string;
  description: string;
  type?: 'website' | 'article';
}

interface Props {
  title: string;
  lang?: 'it' | 'en';
  description?: string;
  /** False only for `/404`: it carries no real URL of its own (SPEC.md §3), so no canonical. */
  canonical?: boolean;
  hreflang?: readonly Hreflang[];
  og?: OpenGraph;
  jsonLd?: PersonJsonLd | LearningResourceJsonLd;
}

const { title, lang = site.lang, description, canonical = true, hreflang, og, jsonLd } = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const canonicalUrl = canonical ? pageUrl : undefined;
const ogImageUrl = og && Astro.site ? new URL(og.image, Astro.site).toString() : undefined;
const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';
const jsonLdScript = jsonLd ? serializeJsonLd(jsonLd) : undefined;

const beaconToken = site.analytics.cloudflareBeaconToken;
// Never on a preview or before launch, and only once the author has committed a real token (SPEC.md §11, §12.4).
const showBeacon = SITE_INDEXABLE && beaconToken.length > 0;
const beaconData = JSON.stringify({ token: beaconToken });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    {showBeacon && <script defer src={CLOUDFLARE_BEACON_SCRIPT_SRC} data-cf-beacon={beaconData}></script>}
    {!SITE_INDEXABLE && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href="/fonts/host-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {hreflang?.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {
      og && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={og.description} />
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:url" content={pageUrl} />
          <meta property="og:type" content={og.type ?? 'website'} />
          <meta property="og:locale" content={ogLocale} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {jsonLdScript && <script type="application/ld+json" set:html={jsonLdScript} />}
  </head>
  <body>
    <div class="site">
      <SiteHeader lang={lang} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
