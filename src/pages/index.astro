---
import { getCollection } from 'astro:content';
import Bio from '../components/about/Bio.astro';
import Colophon from '../components/about/Colophon.astro';
import OpenSource from '../components/about/OpenSource.astro';
import Percorso from '../components/about/Percorso.astro';
import RecentLetture from '../components/lettura/RecentLetture.astro';
import Base from '../layouts/Base.astro';
import { site } from '../config/site.ts';
import { orderLetture } from '../lib/lettura-order.ts';
import { personJsonLd } from '../lib/person-json-ld.ts';

const collection = await getCollection('letture');
const recent = orderLetture(collection).letto.slice(0, 3);

const homeUrl = new URL('/', Astro.site).toString();
const enUrl = new URL('/en/', Astro.site).toString();
const description = "Simone Petta: letture, percorso e progetti open source.";
---

<Base
  title={site.author}
  lang="it"
  description={description}
  canonical
  hreflang={[
    { lang: 'it', href: homeUrl },
    { lang: 'en', href: enUrl },
  ]}
  og={{ image: '/og/about.png', description }}
  jsonLd={personJsonLd(homeUrl)}
>
  <div class="page">
    <h1 class="page__full">{site.author}</h1>
    <!-- Author-voice copy stays a visible placeholder until the author writes it (SPEC.md §1.2). -->
    <p class="lede placeholder">Presentazione: la scrive l'autore.</p>
    <Bio lang="it" />
    <Percorso lang="it" />
    <OpenSource lang="it" />
    <RecentLetture entries={recent} />
    <Colophon lang="it" />
  </div>
</Base>
