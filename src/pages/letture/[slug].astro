---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Post from '../../components/lettura/Post.astro';
import Base from '../../layouts/Base.astro';
import { hasPost } from '../../lib/lettura-post.ts';

export async function getStaticPaths() {
  const collection = await getCollection('letture');
  return collection.filter(hasPost).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'letture'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Title and author are facts, not author voice: a functional description (SPEC.md §1.2 point 3).
const description = `${entry.data.titolo}, di ${entry.data.autore} — dalle letture di Simone Petta.`;
---

<Base
  title={entry.data.titolo}
  og={{ image: '/og/letture.png', description, type: 'article' }}
>
  <a class="back" href="/letture/">Letture</a>
  <Post data={entry.data}>
    <Content />
  </Post>
</Base>

<style>
  .back {
    display: block;
    margin-bottom: 1.5rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
