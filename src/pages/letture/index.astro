---
import { getCollection } from 'astro:content';
import BookGroups from '../../components/lettura/BookGroups.astro';
import Shelf from '../../components/lettura/Shelf.astro';
import Base from '../../layouts/Base.astro';
import { LETTURE_SECTION_DESCRIPTION } from '../../lib/lettura-meta.ts';
import { orderLetture, shelfOrder } from '../../lib/lettura-order.ts';

const collection = await getCollection('letture');
const grouped = orderLetture(collection);
const shelf = shelfOrder(grouped);
---

<Base title="Letture" og={{ image: '/og/letture.png', description: LETTURE_SECTION_DESCRIPTION }}>
  <div class="page">
    <h1 class="page__full">Letture</h1>
    <!-- Author-voice copy stays a visible placeholder until the author writes it (SPEC.md §1.2). -->
    <p class="lede placeholder">Presentazione della sezione: la scrive l'autore.</p>
    <div class="page__full">
      <Shelf entries={shelf} />
    </div>
    <div class="page__full">
      <BookGroups grouped={grouped} />
    </div>
  </div>
</Base>
