---
import Bio from '../../components/about/Bio.astro';
import Colophon from '../../components/about/Colophon.astro';
import OpenSource from '../../components/about/OpenSource.astro';
import Percorso from '../../components/about/Percorso.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site.ts';
import { personJsonLd } from '../../lib/person-json-ld.ts';

const homeUrl = new URL('/', Astro.site).toString();
const enUrl = new URL('/en/', Astro.site).toString();
const description = 'Simone Petta: readings, path and open source projects.';
---

<Base
  title={site.author}
  lang="en"
  description={description}
  canonical
  hreflang={[
    { lang: 'it', href: homeUrl },
    { lang: 'en', href: enUrl },
  ]}
  og={{ image: '/og/about.png', description }}
  jsonLd={personJsonLd(enUrl)}
>
  <div class="page">
    <h1 class="page__full">{site.author}</h1>
    <!-- Author-voice copy stays a visible placeholder until the author writes it (SPEC.md §1.2). -->
    <p class="lede placeholder">Lede: written by the author.</p>
    <Bio lang="en" />
    <Percorso lang="en" />
    <OpenSource lang="en" />
    <Colophon lang="en" />
  </div>
</Base>
