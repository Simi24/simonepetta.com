---
import { lede } from '../../config/about-texts.ts';
import Bio from '../../components/about/Bio.astro';
import Colophon from '../../components/about/Colophon.astro';
import OpenSource from '../../components/about/OpenSource.astro';
import Percorso from '../../components/about/Percorso.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site.ts';
import { personJsonLd } from '../../lib/person-json-ld.ts';

const homeUrl = new URL('/', Astro.site).toString();
const enUrl = new URL('/en/', Astro.site).toString();
// No "readings" here: this page has none (SPEC.md §8, both descriptions are functional, not author voice).
const description = 'Simone Petta: path and open source projects.';
---

<Base
  title={site.author}
  lang="en"
  description={description}
  hreflang={[
    { lang: 'it', href: homeUrl },
    { lang: 'en', href: enUrl },
  ]}
  og={{ image: '/og/about.png', description }}
  jsonLd={personJsonLd(homeUrl)}
>
  <div class="page">
    <h1 class="page__full">{site.author}</h1>
    <p class="lede">{lede.en}</p>
    <Bio lang="en" />
    <Percorso lang="en" />
    <OpenSource lang="en" />
    <Colophon lang="en" />
  </div>
</Base>
