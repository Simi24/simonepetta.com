---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<!-- The prototype's `.full-block`: 2px top rule, heading above full-width content (docs/prototype/visual.html:79). -->
<section class="full-block" id={id}>
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .full-block {
    border-top: 2px solid var(--ink);
    padding-top: 0.8rem;
    margin-top: 3rem;
  }

  h2 {
    margin: 0 0 1.2rem;
    font-size: 1.05rem;
  }
</style>
