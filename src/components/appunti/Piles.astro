---
import FullBlock from './FullBlock.astro';
import { notebookHeightPx, pileLabel, type Pile } from '../../lib/appunti-index.ts';
import { FORMAT_LABEL } from '../../lib/appunti-presentation.ts';
import { slugHash, tintForSlug } from '../../lib/lettura-spine.ts';

interface Props {
  piles: readonly Pile[];
}

const { piles } = Astro.props;

/** The prototype's per-notebook sideways jitter, -4 to +4 px, from the slug so it never changes between builds. */
const jitterPx = (slug: string): number => (slugHash(slug) % 9) - 4;
---

<FullBlock id="piles" title="Corsi">
  {
    piles.length === 0 ? (
      <p class="empty">Nessun corso pubblicato.</p>
    ) : (
      <>
        <div class="piles">
          {piles.map((pile) => {
            const label = pileLabel(pile);
            return (
              <div class="pile-col">
                <div class="pile">
                  {pile.courses.map((course) => {
                    const offset = jitterPx(course.id);
                    const pages = course.pagine === undefined ? '' : `${course.pagine} pagine, `;
                    return (
                      <a
                        class={`nb nb--tint-${tintForSlug(course.id)}${course.stato === 'html' ? ' nb--html' : ''}${course.stato === 'scansione' ? ' nb--scan' : ''}`}
                        href={`/appunti/${course.id}/`}
                        style={`height:calc(1.35rem + ${notebookHeightPx(course.pagine)}px);margin-left:${offset}px;margin-right:${-offset}px;`}
                        title={`${course.titolo}, ${pages}${FORMAT_LABEL[course.stato]}`}
                      >
                        <span>{course.titolo}</span>
                      </a>
                    );
                  })}
                </div>
                <p class="pile-year">
                  {label.year}
                  <span>{label.level}</span>
                </p>
              </div>
            );
          })}
        </div>
        <p class="caption">
          Lo spessore segue le pagine di appunti. La linguetta indica che il corso si legge anche in pagina web; il bordo tratteggiato è
          un quaderno scansionato.
        </p>
      </>
    )
  }
</FullBlock>

<style>
  .piles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
  }

  .pile-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pile {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: 0 0.7rem 0 0.2rem;
    border-bottom: 6px solid var(--ink);
  }

  .nb {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0 0.55rem;
    border-radius: 1px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: translate 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nb > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .nb:hover,
  .nb:focus-visible {
    translate: 4px 0;
  }

  .nb--html::after {
    content: '';
    position: absolute;
    right: -0.6rem;
    top: 50%;
    translate: 0 -50%;
    width: 0.6rem;
    height: 0.85rem;
    background: var(--ink);
    border-radius: 0 1px 1px 0;
  }

  .nb--tint-1 {
    background: var(--tint-1);
    color: var(--tint-1-ink);
  }

  .nb--tint-2 {
    background: var(--tint-2);
    color: var(--tint-2-ink);
  }

  .nb--tint-3 {
    background: var(--tint-3);
    color: var(--tint-3-ink);
  }

  .nb--tint-4 {
    background: var(--tint-4);
    color: var(--tint-4-ink);
  }

  .nb--tint-5 {
    background: var(--tint-5);
    color: var(--tint-5-ink);
  }

  /* After the tints, so the scan's transparent background wins at equal specificity. */
  .nb.nb--scan {
    background: transparent;
    color: var(--muted);
  }

  /* Focused, the scan takes the shared focus outline instead of its dashed edge. */
  .nb.nb--scan:not(:focus-visible) {
    outline: 1.5px dashed var(--muted);
    outline-offset: -1.5px;
  }

  .pile-year {
    margin: 0.45rem 0 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .pile-year span {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .caption,
  .empty {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .piles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
</style>
