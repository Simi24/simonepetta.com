---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../config/site.ts';
import { sections } from '../config/nav.ts';
---

<header class="site-header">
  <a class="brand" href="/">{site.author}</a>
  <div class="site-header__end">
    {
      sections.length > 0 && (
        <nav aria-label="Sezioni">
          {sections.map((section) => (
            <a
              href={section.href}
              lang={section.lang}
              aria-current={Astro.url.pathname === section.href ? 'page' : undefined}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )
    }
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    font-weight: 500;
  }

  .site-header__end,
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.8rem;
  }

  .brand,
  nav a {
    text-decoration: none;
  }

  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
