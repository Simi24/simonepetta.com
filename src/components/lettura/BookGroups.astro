---
import type { GroupedLetture } from '../../lib/lettura-order.ts';
import { STATO_PRESENTATION } from '../../lib/lettura-presentation.ts';
import { STATI_LETTURA } from '../../schemas/lettura.ts';
import BookList from './BookList.astro';
import BookRow from './BookRow.astro';

interface Props {
  grouped: GroupedLetture;
}

const { grouped } = Astro.props;
---

{
  STATI_LETTURA.map((stato) => {
    const entries = grouped[stato];
    if (entries.length === 0) return null;
    return (
      <section class="books-group">
        <h2>{STATO_PRESENTATION[stato].groupLabel}</h2>
        <BookList>
          {entries.map((entry) => <BookRow entry={entry} />)}
        </BookList>
      </section>
    );
  })
}

<style>
  /* A 12-column grid per section: label in columns 1-4, content from column 5 (SPEC.md §5.2). */
  .books-group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    border-top: 2px solid var(--ink);
    padding-top: 0.8rem;
    margin-top: 2.5rem;
  }

  .books-group h2 {
    grid-column: 1 / span 4;
    margin: 0;
    font-size: 1.05rem;
  }

  .books-group :global(.book-list) {
    grid-column: 5 / -1;
  }

  @media (max-width: 860px) {
    .books-group h2,
    .books-group :global(.book-list) {
      grid-column: 1 / -1;
    }
  }
</style>
