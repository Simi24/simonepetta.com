---
import type { CollectionEntry } from 'astro:content';
import { postHref } from '../../lib/lettura-post.ts';
import { spineLook } from '../../lib/lettura-spine.ts';
import '../../styles/shelf.css';

interface Props {
  entries: readonly CollectionEntry<'letture'>[];
}

const { entries } = Astro.props;

function look(entry: CollectionEntry<'letture'>) {
  return spineLook({ slug: entry.id, ...entry.data });
}
---

<div class="shelf-wrap">
  <div class="shelf" role="list">
    {
      entries.map((entry) => {
        const href = postHref(entry);
        const spine = look(entry);
        const Tag = href ? 'a' : 'span';
        return (
          // ARIA in HTML forbids `role="listitem"` on `a[href]` (it replaces the link role),
          // so list semantics sit on this wrapper, not on the link itself (SPEC.md §12.1).
          <span role="listitem">
            <Tag
              class={spine.className}
              href={href}
              style={`height:${spine.heightRem}rem;width:${spine.widthRem}rem;`}
              title={spine.label}
            >
              <span>{spine.title}</span>
              <span class="spine__author">{spine.surname}</span>
            </Tag>
          </span>
        );
      })
    }
  </div>
  <p class="caption">
    {
      entries.length === 0
        ? 'Lo scaffale è vuoto.'
        : "L'altezza del dorso segue le pagine. Il segnalibro indica il libro in corso, quello inclinato è stato abbandonato."
    }
  </p>
</div>
