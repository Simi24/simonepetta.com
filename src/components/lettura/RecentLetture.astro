---
import type { CollectionEntry } from 'astro:content';
import BookList from './BookList.astro';
import BookRow from './BookRow.astro';

interface Props {
  entries: readonly CollectionEntry<'letture'>[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="recent">
      <h2>Ultime letture</h2>
      <BookList>
        {entries.map((entry) => <BookRow entry={entry} compact />)}
      </BookList>
    </section>
  )
}

<style>
  .recent {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: 1.5rem;
    border-top: 2px solid var(--ink);
    padding-top: 0.8rem;
    margin-top: 3rem;
  }

  .recent h2 {
    grid-column: 1 / -1;
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }

  .recent :global(.book-list) {
    grid-column: 1 / -1;
  }
</style>
