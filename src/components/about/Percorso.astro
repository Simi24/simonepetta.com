---
// Author-voice copy stays a visible placeholder until the author writes it (SPEC.md §1.2).
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const heading = lang === 'en' ? 'Path' : 'Percorso';
const placeholder = lang === 'en' ? "Path: written by the author." : "Percorso: lo scrive l'autore.";
---

<section class="block">
  <h2>{heading}</h2>
  <p class="placeholder">{placeholder}</p>
</section>
