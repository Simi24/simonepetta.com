---
import { path } from '../../config/about-texts.ts';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const heading = lang === 'en' ? 'Path' : 'Percorso';
---

<section class="block">
  <h2>{heading}</h2>
  <ol class="timeline">
    {
      path[lang].map((entry) => (
        <li>
          <span class="when">{entry.when}</span>
          <span>{entry.text}</span>
        </li>
      ))
    }
  </ol>
</section>
