---
import { projectDescriptions } from '../../config/about-texts.ts';
import { projects } from '../../config/projects.ts';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
---

<section class="block">
  <h2>Open source</h2>
  <ul class="projects">
    {
      projects.map((project) => (
        <li>
          <a href={project.href}>{project.name}</a> <span>{projectDescriptions[lang][project.name]}</span>
        </li>
      ))
    }
  </ul>
</section>
