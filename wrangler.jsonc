{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simonepetta-com",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "simonepetta.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
